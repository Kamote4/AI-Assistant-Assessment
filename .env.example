# Ollama configuration
# Make sure Ollama is running locally before starting the app.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT=60

# Flask configuration
# Use False in production.
FLASK_DEBUG=True

# Replace this with a strong random value in production.
# This value is only a placeholder for local/demo use.
SECRET_KEY=change-this-in-production

# Input validation
MAX_ENQUIRY_LENGTH=5000
MIN_ENQUIRY_LENGTH=10

# Logging
# LOG_FULL_ENQUIRY should stay False unless debugging locally.
# Enquiries may contain sensitive client information.
LOG_LEVEL=INFO
LOG_TO_FILE=True
LOG_FULL_ENQUIRY=False
LOG_DIR=logs

# Outbound webhook (optional)
# After each analysis, the app fires a POST to WEBHOOK_URL with the result.
# Leave WEBHOOK_URL blank to disable. WEBHOOK_SECRET signs payloads with
# HMAC-SHA256 — leave blank to skip signing.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=5
