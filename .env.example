# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT=60

# Flask configuration
FLASK_DEBUG=True
SECRET_KEY=change-this-in-production

# Input validation
MAX_ENQUIRY_LENGTH=5000
MIN_ENQUIRY_LENGTH=10

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=True
LOG_FULL_ENQUIRY=False
LOG_DIR=logs
